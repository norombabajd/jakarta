		margin-block: 2rem;
		border: 4px solid black;
		box-shadow: 6px 6px 0 0 black;
		outline: 1px solid rgba(0, 0, 0, 0.1);
		outline-offset: -1px;
	}

	@media (max-width: 47.999rem) {
		.now-sections {
			font-size: 1rem;
		}

		.now-sections > .now-section {
			padding: 1.25rem;
		}

		.now-sections ul,
		.now-sections ol {
			padding-inline-start: 1.25rem;
		}
	}

	@media (min-width: 48rem) {
