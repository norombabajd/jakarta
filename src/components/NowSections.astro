		background: white;
		border: 4px solid black;
		box-shadow: 8px 8px 0 0 black;
	}

	.now-sections h1,
	.now-sections h2,
	.now-sections h3,
	.now-sections h4,
	.now-sections h5,
	.now-sections h6 {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-synthesis: none;
		text-wrap: balance;
	}

	.now-sections h1 {
		font-weight: 500;
	}

	.now-sections h2 {
		font-weight: 600;
	}

	.now-sections h3,
	.now-sections h4,
	.now-sections h5,
	.now-sections h6 {
		font-weight: 500;
	}

	.now-sections > .now-section > h1:first-child {
		margin: 0 0 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid black;
		color: black;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.now-sections > .now-section > :first-child:not(h1) {
		margin-top: 0;
	}

	.now-sections > .now-section > :last-child {
		margin-bottom: 0;
	}

	.now-sections p,
