---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface LinkedItem {
	title: string;
	creator?: string;
	artist?: string;
	description?: string;
	attribution?: string;
	link?: string;
	cover?: ImageMetadata;
}

interface Props {
	watching?: LinkedItem[];
	listening?: LinkedItem[];
	reading?: LinkedItem[];
}

const { watching = [], listening = [], reading = [] } = Astro.props;
const sections = [
	{ title: 'Watching', type: 'watching', items: watching },
	{ title: 'Listening', type: 'listening', items: listening },
	{ title: 'Reading', type: 'reading', items: reading },
].filter(({ items }) => items.length > 0);

const getSourceLabel = (link: string) => {
	try {
		const hostname = new URL(link).hostname.replace(/^www\./, '');
		if (hostname.endsWith('wikipedia.org')) return 'Wikipedia';
		if (hostname.endsWith('wikimedia.org')) return 'Wikimedia Commons';
		if (hostname.endsWith('themoviedb.org')) return 'TMDB';
		return hostname;
	} catch {
		return 'Source';
	}
};

const attributions = sections.flatMap(({ items }) =>
	items
		.filter((item) => item.attribution)
		.map((item) => ({
			title: item.title,
			link: item.attribution!,
			source: getSourceLabel(item.attribution!),
		})),
);
---

{sections.length > 0 && (
	<div class="now-lists">
		{sections.map(({ title, type, items }) => (
			<section class:list={['now-list', `now-list--${type}`]} aria-labelledby={`now-${type}`}>
				<h2 id={`now-${title.toLowerCase()}`}>{title}</h2>
				<ul>
					{items.map((item) => {
						const ItemElement = item.link ? 'a' : 'div';
						const linkAttributes = item.link
							? { href: item.link, target: '_blank', rel: 'noopener noreferrer' }
							: {};

						return (
						<li>
							<ItemElement
								{...linkAttributes}
								class:list={['item-link', { 'has-thumbnail': item.cover, 'is-linked': item.link }]}
							>
								{item.cover && (
									<span class="item-thumbnail" aria-hidden="true">
										<Image
											src={item.cover}
											alt=""
											draggable={false}
											widths={[64, 96, 144]}
											sizes="4.5rem"
											class="item-cover"
										/>
									</span>
								)}
								<span class="item-copy">
									<strong>{item.title}</strong>
									{(item.artist || item.creator) && (
										<span class="item-byline">{item.artist || item.creator}</span>
									)}
									{item.description && <span class="item-description">{item.description}</span>}
								</span>
								{item.link && <span class="arrow" aria-hidden="true">↗</span>}
							</ItemElement>
						</li>
						);
					})}
				</ul>
			</section>
		))}

		{attributions.length > 0 && (
			<aside
				class="attribution-card bg-white border-4 border-black shadow-[8px_8px_0px_0px_#000] p-6 md:p-8"
				aria-labelledby="image-attributions"
			>
				<h2 id="image-attributions">Image attributions</h2>
				<ul>
					{attributions.map((attribution) => (
						<li>
							<a href={attribution.link} target="_blank" rel="noopener noreferrer">
								<span>{attribution.title}</span>
								<span class="source">{attribution.source} ↗</span>
							</a>
						</li>
					))}
				</ul>
			</aside>
		)}
	</div>
)}

<style>
	.now-lists {
		display: grid;
		gap: 1.5rem;
	}

	.now-list {
		--cover-width: 3.5rem;
		background: white;
		border: 4px solid black;
		box-shadow: 8px 8px 0 0 black;
		padding: 1.5rem;
	}

	.now-list--listening {
		--cover-width: 4.5rem;
	}

	h2 {
		font-size: 1.5rem;
		font-weight: 900;
		line-height: 1.2;
		margin: 0 0 1rem;
		text-wrap: balance;
	}

	.now-list > ul {
		display: grid;
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.now-list li + li {
		border-top: 2px solid black;
	}

	.item-link {
		align-items: start;
		column-gap: 1rem;
		color: black;
		display: grid;
		grid-template-areas: 'meta arrow';
		grid-template-columns: minmax(0, 1fr) auto;
		min-height: 4rem;
		padding: 0.75rem 0;
		text-decoration: none;
		transition-property: color, transform;
		transition-duration: 150ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.item-link.has-thumbnail {
		grid-template-areas: 'thumbnail meta arrow';
		grid-template-columns: var(--cover-width) minmax(0, 1fr) auto;
	}

	.item-thumbnail {
		aspect-ratio: 2 / 3;
		background: #f3f4f6;
		display: block;
		grid-area: thumbnail;
		outline: 1px solid rgba(0, 0, 0, 0.1);
		overflow: hidden;
		width: var(--cover-width);
	}

	.now-list--listening .item-thumbnail {
		aspect-ratio: 1;
	}

	.item-thumbnail :global(.item-cover) {
		display: block;
		height: 100% !important;
		margin: 0 !important;
		max-width: none;
		object-fit: contain;
		object-position: center;
		width: 100% !important;
	}

	.item-link.is-linked:hover {
		color: #2563eb;
	}

	.item-link.is-linked:active {
		transform: scale(0.96);
	}

	.item-link.is-linked:focus-visible {
		outline: 3px solid #2563eb;
		outline-offset: 3px;
	}

	.item-copy {
		align-items: flex-start;
		display: flex !important;
		flex-direction: column !important;
		gap: 0.15rem;
		grid-area: meta;
		justify-content: flex-start;
		min-width: 0;
		width: 100%;
	}

	strong {
		font-size: 1.05rem;
		line-height: 1.3;
		text-wrap: pretty;
	}

	.item-byline {
		color: #4b5563;
		font-size: 0.875rem;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.item-description {
		color: #6b7280;
		font-size: 0.925rem;
		font-style: italic;
		font-weight: 400;
		line-height: 1.5;
		margin-top: 0.5rem;
		text-wrap: pretty;
	}

	.item-link.is-linked:hover .item-byline,
	.item-link.is-linked:hover .item-description {
		color: #1d4ed8;
	}

	.arrow {
		align-self: center;
		font-size: 1.25rem;
		font-weight: 900;
		grid-area: arrow;
	}

	.attribution-card {
		color: #4b5563;
	}

	.attribution-card h2 {
		color: #4b5563;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		margin: 0 0 0.35rem;
		text-transform: uppercase;
	}

	.attribution-card ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.attribution-card li + li {
		border-top: 1px solid #d1d5db;
	}

	.attribution-card a {
		align-items: center;
		color: #4b5563;
		display: flex;
		font-size: 0.75rem;
		gap: 1rem;
		justify-content: space-between;
		line-height: 1.4;
		min-height: 2.5rem;
		text-decoration: none;
		text-wrap: pretty;
	}

	.attribution-card a:hover {
		color: #1d4ed8;
		text-decoration: underline;
	}

	.attribution-card a:focus-visible {
		outline: 2px solid #2563eb;
		outline-offset: 2px;
	}

	.source {
		flex: 0 0 auto;
		font-weight: 700;
	}

	@media (min-width: 48rem) {
		.now-list {
			padding: 2rem;
		}

	}
</style>
